# Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql://trading_user:trading_pass_change_me@localhost:5432/trading_platform
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Security
SECRET_KEY=your-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Broker API Keys (Optional - for live trading)
# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Angel One
ANGEL_CLIENT_ID=
ANGEL_API_KEY=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Zerodha
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Market Data
NSE_COOKIE=

# Paper Trading (Default)
PAPER_TRADING_ENABLED=true
PAPER_TRADING_CAPITAL=100000

# AI Settings
AI_MIN_CONFIDENCE=75
AI_MIN_RISK_REWARD=2.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
